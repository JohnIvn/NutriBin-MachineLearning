[Unit]
Description=NutriBin Desktop App with Auto Live Detection
After=graphical.target network-online.target
Wants=network-online.target graphical.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/NutriBin-MachineLearning
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/admin/.Xauthority
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash /home/admin/NutriBin-MachineLearning/scripts/start_desktop_app_fixed.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
